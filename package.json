{
  "name": "template-bun",
  "module": "index.ts",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker_build": "docker build --pull -t $npm_package_name .",
    "docker_run": "docker run --env-file .env -e PORT=3000 -p 3000:3000 -d --name $npm_package_name $npm_package_name"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sentry/bun": "^11.9.0",
    "zod": "^4.6.7"
  }
}
